<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build settings and the common game references live in Directory.Build.props above this folder.
       This file names the plugin and adds the game assemblies that only this mod uses. -->
  <PropertyGroup>
    <AssemblyName>ItemHighlight</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(GameManaged)\Mirror.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameManaged)\Unity.RenderPipelines.HighDefinition.Runtime.dll"><Private>false</Private></Reference>
    <Reference Include="$(GameManaged)\Unity.RenderPipelines.Core.Runtime.dll"><Private>false</Private></Reference>
    <!-- The stripped module of the game has no Physics.IgnoreLayerCollision. The BepInEx pack puts this folder first in the search path. -->
    <Reference Include="$(GameDir)\unstripped_libs\UnityEngine.PhysicsModule.dll"><Private>false</Private></Reference>
  </ItemGroup>

</Project>
